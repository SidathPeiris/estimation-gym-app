{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/data/**",
              "components/display/**",
              "components/feedback/**",
              "components/forms/**",
              "components/game/**",
              "components/navigation/**",
              "ui_kits/app/**",
              "ui_kits/install/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Bricolage Grotesque|Schibsted Grotesk|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Bricolage Grotesque, Schibsted Grotesk, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:date|streak|best|reminderOn|onReminder|onMenu|compact|style|key|ref|className|style|children)$/]",
        "message": "<AppHeader> doesn't accept that prop. Declared props: date, streak, best, reminderOn, onReminder, onMenu, compact, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BandBars'] > JSXAttribute > JSXIdentifier[name!=/^(?:rows|mine|showTally|style|key|ref|className|style|children)$/]",
        "message": "<BandBars> doesn't accept that prop. Declared props: rows, mine, showTally, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BandTag'] > JSXAttribute > JSXIdentifier[name!=/^(?:band|variant|size|assisted|style|key|ref|className|style|children)$/]",
        "message": "<BandTag> doesn't accept that prop. Declared props: band, variant, size, assisted, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BandTag'] > JSXAttribute[name.name='band'] > Literal[value!=/^(?:Bullseye|Close|Ballpark|Off)$/]",
        "message": "<BandTag> band must be one of 'Bullseye' | 'Close' | 'Ballpark' | 'Off'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BandTag'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:pill|dot|plain)$/]",
        "message": "<BandTag> variant must be one of 'pill' | 'dot' | 'plain'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BandTag'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<BandTag> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Brandmark'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|tone|ringPulse|style|key|ref|className|style|children)$/]",
        "message": "<Brandmark> doesn't accept that prop. Declared props: size, tone, ringPulse, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Brandmark'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:brand|mono)$/]",
        "message": "<Brandmark> tone must be one of 'brand' | 'mono'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|tone|icon|iconAfter|block|disabled|as|href|type|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, tone, icon, iconAfter, block, disabled, as, href, type, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:soft|solid|quiet|ghost)$/]",
        "message": "<Button> variant must be one of 'soft' | 'solid' | 'quiet' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:button|a)$/]",
        "message": "<Button> as must be one of 'button' | 'a'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Button> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Callout'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|children|tone|icon|style|key|ref|className|style|children)$/]",
        "message": "<Callout> doesn't accept that prop. Declared props: title, children, tone, icon, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|icon|tone|style|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: children, icon, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Disclosure'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|summary|icon|open|defaultOpen|onToggle|children|divider|style|key|ref|className|style|children)$/]",
        "message": "<Disclosure> doesn't accept that prop. Declared props: title, summary, icon, open, defaultOpen, onToggle, children, divider, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='GuessField'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|onSubmit|unit|placeholder|error|submitLabel|disabled|showExponent|autoFocus|style|key|ref|className|style|children)$/]",
        "message": "<GuessField> doesn't accept that prop. Declared props: value, onChange, onSubmit, unit, placeholder, error, submitLabel, disabled, showExponent, autoFocus, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='HistoryRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:date|band|guess|actual|decades|assisted|comparable|open|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<HistoryRow> doesn't accept that prop. Declared props: date, band, guess, actual, decades, assisted, comparable, open, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='HistoryRow'] > JSXAttribute[name.name='band'] > Literal[value!=/^(?:Bullseye|Close|Ballpark|Off)$/]",
        "message": "<HistoryRow> band must be one of 'Bullseye' | 'Close' | 'Ballpark' | 'Off'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|base|title|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, base, title, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuestionCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:prompt|date|asOf|mode|label|icon|number|archetype|badge|answered|children|style|key|ref|className|style|children)$/]",
        "message": "<QuestionCard> doesn't accept that prop. Declared props: prompt, date, asOf, mode, label, icon, number, archetype, badge, answered, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuestionCard'] > JSXAttribute[name.name='mode'] > Literal[value!=/^(?:daily|practice)$/]",
        "message": "<QuestionCard> mode must be one of 'daily' | 'practice'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ResultCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:band|points|guess|actual|unit|decades|assisted|practice|children|style|key|ref|className|style|children)$/]",
        "message": "<ResultCard> doesn't accept that prop. Declared props: band, points, guess, actual, unit, decades, assisted, practice, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ResultCard'] > JSXAttribute[name.name='band'] > Literal[value!=/^(?:Bullseye|Close|Ballpark|Off)$/]",
        "message": "<ResultCard> band must be one of 'Bullseye' | 'Close' | 'Ballpark' | 'Off'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScoringTable'] > JSXAttribute > JSXIdentifier[name!=/^(?:compact|style|key|ref|className|style|children)$/]",
        "message": "<ScoringTable> doesn't accept that prop. Declared props: compact, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BandRun'] > JSXAttribute > JSXIdentifier[name!=/^(?:run|size|gap|style|key|ref|className|style|children)$/]",
        "message": "<BandRun> doesn't accept that prop. Declared props: run, size, gap, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
